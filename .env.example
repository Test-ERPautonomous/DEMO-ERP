# ==============================================================================
# Najm Al Huda Garage & Workshop ERP - Environment Variables
# ==============================================================================

# Server & Host Runtime Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Active Supabase Project Credentials (Backend Server)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# 1. Project URL (e.g., https://your-project-ref.supabase.co)
SUPABASE_URL=

# 2. Public Anonymous API Key (JWT token starting with eyJhbGci...)
SUPABASE_ANON_KEY=

# 3. Private Service Role Secret (starts with sb_secret_ or service_role JWT)
# NEVER prefix with VITE_ and NEVER expose to browser code
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Client Configuration (Vite Frontend)
# Matches SUPABASE_URL
VITE_SUPABASE_URL=
# Matches SUPABASE_ANON_KEY (Public/anon key ONLY)
VITE_SUPABASE_ANON_KEY=

# Master Admin One-Time Setup Secret
MASTER_BOOTSTRAP_SECRET=your-secure-bootstrap-secret-here

# Application Settings
VITE_APP_CURRENCY=QAR
VITE_API_URL=
