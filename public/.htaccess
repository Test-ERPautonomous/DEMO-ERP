# ==============================================================================
# Najm Al Huda Workshop ERP - Hostinger Web Server Configuration (.htaccess)
# Compatible with LiteSpeed and Apache on Hostinger Web / Cloud Hosting
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS (Hostinger Free SSL)
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Block direct HTTP access to sensitive project files & database storage
  RewriteRule ^\.env - [F,L,NC]
  RewriteRule ^data/.*\.db.*$ - [F,L,NC]
  RewriteRule ^data/.*\.sqlite.*$ - [F,L,NC]
  RewriteRule ^(\.git|\.github|tests|server) - [F,L,NC]
  RewriteRule ^(package\.json|package-lock\.json|tsconfig\.json|metadata\.json)$ - [F,L,NC]

  # 3. Phusion Passenger support (if enabled in Hostinger cPanel/hPanel)
  # PassengerAppRoot "/home/username/domains/yourdomain.com/public_html"
  # PassengerAppType node
  # PassengerStartupFile server.js

  # 4. If Node.js backend runs on internal port (reverse proxy configuration)
  # RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

  # 5. SPA Frontend routing fallback: deliver index.html for non-file requests
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser Caching for Production Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json image/svg+xml
</IfModule>
